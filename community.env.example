# AIRO Community Edition — copy to .env next to docker-compose.yml.

# PostgreSQL superuser password (also used by the PostgREST authenticator role).
# Letters and digits only (it is passed on a libpq connection string):
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Shared HS256 secret: PostgREST verifies, the app signs. 32+ characters.
#   openssl rand -hex 32
AIRO_JWT_SECRET=

# The one owner account. Password is compared in constant time; 5 tries / 15 min.
AIRO_OWNER_PASSWORD=
AIRO_OWNER_EMAIL=owner@localhost

# Public address you open the app at (Tailscale hostname, tunnel, or localhost).
AIRO_SITE_URL=http://localhost:3002
AIRO_PORT=3002

# Optional. Without a key the chat uses your Codex bridge or direct itinerary editing.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional. Google Places (New) for ratings/hours; blank = OpenStreetMap only.
GOOGLE_MAPS_API_KEY=

# Optional. Extra browser origins allowed to call /api/mcp, comma separated.
MCP_ALLOWED_ORIGINS=
