# Supabase — 프로젝트 Connect 또는 Settings > API Keys의 Project URL과 Publishable key.
# 기존 변수 이름을 유지하며 sb_publishable_ 키와 legacy anon 키를 모두 지원한다.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Google 로그인: Supabase Auth의 Google 제공자에 OAuth Client ID/Secret을 등록.
# 활성화 상태를 서버에서 읽으므로 별도 공개 플래그나 재빌드가 필요하지 않다.

# MCP API 키 인증 전용. Supabase Settings > API > JWT Settings 의 JWT Secret.
# Bearer 토큰으로 들어온 MCP 요청을 "그 사용자 본인" JWT 로 바꿔 RLS 를 그대로
# 적용하는 데 쓴다. service_role 키는 쓰지 않는다 — 넣지 마라.
SUPABASE_JWT_SECRET=super-secret-jwt-token-...

# MCP OAuth: MCP_SETUP.md의 Supabase OAuth Server / Custom Access Token Hook 설정 후 true.
# OAuth JWT는 Supabase에서 검증하므로 위의 legacy 서명 비밀값 없이도 OAuth 연결이 가능하다.
MCP_OAUTH_ENABLED=false
# Origin을 보내는 웹 MCP 클라이언트만 필요. 정확한 origin을 쉼표로 구분, 와일드카드 금지.
MCP_ALLOWED_ORIGINS=

# 앱이 매직링크/OAuth 리다이렉트를 만들 때 쓰는 주소
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# OpenAI — 채팅 도구 호출용. 서버에서만 읽는다. NEXT_PUBLIC_ 붙이지 말 것.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# 선택 — 넣으면 장소 검색이 Google Places (New) 로 바뀐다. 평점·리뷰수·영업중 여부까지
# 함께 온다. 넣지 않으면 OpenStreetMap(Overpass/Photon)만 쓰고 앱은 그대로 동작한다.
# 필요: 결제 계정이 연결된 Google Cloud 프로젝트 + Places API (New) 활성화.
GOOGLE_MAPS_API_KEY=

# 개발 서버를 Tailscale/LAN 주소로 열 때 허용할 origin (쉼표 구분). 예: 100.x.x.x,my-mac.tailnet.ts.net
NEXT_ALLOWED_DEV_ORIGINS=
